{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebReport — relatório ou sequência de relatórios",
  "description": "Contrato estrutural para editores e validadores externos. O motor não carrega este schema automaticamente.",
  "oneOf": [
    { "$ref": "#/$defs/report" },
    { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/report" } }
  ],
  "$defs": {
    "report": {
      "type": "object",
      "required": ["Structure", "Data"],
      "properties": {
        "Name": { "type": "string" },
        "name": { "type": "string" },
        "Structure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["n", "t", "properties"],
            "properties": {
              "n": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "t": { "type": "integer", "minimum": 0, "maximum": 19 },
              "properties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["t", "v"],
                  "properties": {
                    "t": { "type": ["integer", "null"], "minimum": 1, "maximum": 62 },
                    "v": { "type": ["string", "number", "boolean", "null"] }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": true
          }
        },
        "Data": { "type": "array", "items": { "type": "object" } },
        "config": { "type": "object" },
        "Config": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
